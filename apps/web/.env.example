# API Backend URL (NestJS server, default is 3002)
NEXT_PUBLIC_API_URL=http://localhost:3002

# Frontend Application URL (Next.js storefront, default is 3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# On-demand ISR Revalidation Secret (Must match REVALIDATION_SECRET in apps/api)
REVALIDATION_SECRET="generate_a_secure_revalidation_secret_here"
