{
  "extends": "../../packages/tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@ff/ui": ["../../packages/ui/src/index.tsx"],
      "@ff/ui/*": ["../../packages/ui/src/*"],
      "@ff/schemas": ["../../packages/schemas/src/index.ts"]
