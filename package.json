{
  "name": "platform",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "prepare": "husky || true",
    "typecheck": "turbo typecheck",
    "clean": "rm -rf node_modules .turbo",
    "ci": "pnpm lint && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "^4.1.18",
    "baseline-browser-mapping": "^2.9.19",
    "critters": "^0.0.25",
    "eslint": "^9",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.18",
    "turbo": "2.8.9",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.50.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": "^22.17.0",
    "pnpm": "^10.18.3"
  }
}
