model User {
  id                      String                @id @default(uuid())
  name                    String
  email                   String                @unique
  phone                   String                @unique
  role                    UserRole
  accountStatus           AccountStatus         @default(ACTIVE)
  isPhoneVerified         Boolean               @default(false)
  isEmailVerified         Boolean               @default(false)
  refreshToken            String?
  adminMeta               Json?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  addresses               Address[]
  cartItems               CartItem[]
  devices                 Device[]
  orders                  Order[]
  productClickLogs        ProductClickLog[]
  productNotifications    ProductNotification[]
  productRequests         ProductRequest[]
  referralRewardsReceived ReferralReward[]      @relation("ReferredUser")
  referralRewardsSent     ReferralReward[]      @relation("Referrer")
  referral                Referral?
  reviews                 Review[]
  searchLogs              SearchLog[]
  walletTransactions      WalletTransaction[]
  wallet                  Wallet?
  wishlistItems           WishlistItem[]

  @@map("users")
}

model Wallet {
  id            String   @id @default(uuid())
  userId        String   @unique
  refundBalance Decimal  @default(0) @db.Decimal(12, 2)
  rewardBalance Decimal  @default(0) @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model WalletTransaction {
  id          String                  @id @default(uuid())
  userId      String
  type        WalletType
  amount      Decimal                 @db.Decimal(12, 2)
  reason      String
  status      WalletTransactionStatus @default(PENDING)
  referenceId String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([referenceId])
  @@map("wallet_transactions")
}

model Referral {
  id             String   @id @default(uuid())
  userId         String   @unique
  referralCode   String   @unique
  referredBy     String?
  totalReferrals Int      @default(0)
  totalEarned    Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([referralCode])
  @@index([referredBy])
  @@map("referrals")
}

model ReferralReward {
  id             String               @id @default(uuid())
  referrerId     String
  referredUserId String
  orderId        String               @unique
  rewardAmount   Decimal              @db.Decimal(12, 2)
  status         ReferralRewardStatus @default(PENDING)
  releasedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  referredUser   User                 @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  referrer       User                 @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([referredUserId])
  @@map("referral_rewards")
}

model Device {
  id         String         @id @default(uuid())
  userId     String
  deviceId   String         @unique
  deviceName String
  platform   DevicePlatform
  userAgent  String?
  ipAddress  String?
  lastLogin  DateTime       @default(now())
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

enum UserRole {
  SUPER_ADMIN
  STAFF_ADMIN
  SELLER
  CUSTOMER
  INFLUENCER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
}

enum AdminPermission {
  ADD_PRODUCT
  APPROVE_PRODUCT
  ADD_REVIEW
  MANAGE_ORDERS
  VIEW_PROFIT
  MANAGE_SELLERS
}

enum WalletType {
  REFUND
  REWARD
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ReferralRewardStatus {
  PENDING
  RELEASED
  CANCELLED
}

enum DevicePlatform {
  WEB
  ANDROID
  IOS
}
