enum UserRole {
  SUPER_ADMIN
  STAFF_ADMIN
  SELLER
  CUSTOMER
  INFLUENCER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
}

enum AdminPermission {
  ADD_PRODUCT
  APPROVE_PRODUCT
  ADD_REVIEW
  MANAGE_ORDERS
  VIEW_PROFIT
  MANAGE_SELLERS
}

enum WalletType {
  REFUND
  REWARD
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ReferralRewardStatus {
  PENDING
  RELEASED
  CANCELLED
}

enum DevicePlatform {
  WEB
  ANDROID
  IOS
}

model User {
  id              String         @id @default(uuid())
  name            String
  email           String         @unique
  phone           String         @unique
  avatarUrl       String?
  role            UserRole
  accountStatus   AccountStatus  @default(ACTIVE)
  isPhoneVerified Boolean        @default(false)
  isEmailVerified Boolean        @default(false)
  
  // Admin fields (Postgres JSONB is best for flexible metadata like permissions)
  adminMeta       Json?          // { "permissions": AdminPermission[] }

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Profile Relations
  sellerProfile   SellerProfile?
  wallet          Wallet?
  referral        Referral?
  
  // Activity Relations
  addresses               Address[]
  reviews                 Review[]
  orders                  Order[]
  productsSold            ProductSeller[]
  devices                 Device[]
  walletTransactions      WalletTransaction[]
  referralRewardsSent     ReferralReward[]    @relation("Referrer")
  referralRewardsReceived ReferralReward[]    @relation("ReferredUser")

  @@map("users")
}

model SellerProfile {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  storeName   String
  isVerified  Boolean  @default(false)
  description String?  @db.Text
  logoUrl     String?
  
  totalSales  Int      @default(0)
  rating      Float    @default(0.0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("seller_profiles")
}

model Wallet {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  refundBalance Decimal  @default(0) @db.Decimal(12, 2)
  rewardBalance Decimal  @default(0) @db.Decimal(12, 2)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("wallets")
}

model WalletTransaction {
  id          String                  @id @default(uuid())
  userId      String
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type        WalletType
  amount      Decimal                 @db.Decimal(12, 2)
  reason      String
  status      WalletTransactionStatus @default(PENDING)
  referenceId String?                 // orderId / refundId etc.

  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([userId])
  @@index([referenceId])
  @@map("wallet_transactions")
}

model Referral {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  referralCode   String   @unique
  referredBy     String?  // References User.id but not necessarily a strict relation if it's across systems
  
  totalReferrals Int      @default(0)
  totalEarned    Decimal  @default(0) @db.Decimal(12, 2)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([referralCode])
  @@index([referredBy])
  @@map("referrals")
}

model ReferralReward {
  id             String               @id @default(uuid())
  
  referrerId     String
  referrer       User                 @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  
  referredUserId String
  referredUser   User                 @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  
  orderId        String               @unique // Linked to order
  rewardAmount   Decimal              @db.Decimal(12, 2)
  status         ReferralRewardStatus @default(PENDING)
  
  releasedAt     DateTime?
  
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([referrerId])
  @@index([referredUserId])
  @@map("referral_rewards")
}

model Device {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  deviceId   String         @unique
  deviceName String
  platform   DevicePlatform
  userAgent  String?        @db.Text
  ipAddress  String?
  
  lastLogin  DateTime       @default(now())
  isActive   Boolean        @default(true)

  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([userId])
  @@map("devices")
}
