enum ProductStatus {
  PENDING
  DRAFT
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum ProductCategory {
  WATCHES
  SNEAKERS
  CLOTHING
  ACCESSORIES
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

model Product {
  id             String          @id @default(uuid())
  name           String
  slug           String          @unique
  description    String          @db.Text
  brand          String[]        
  status         ProductStatus   @default(DRAFT)
  category       ProductCategory
  gender         Gender
  
  // Pricing (Stored as Decimal for accuracy)
  ogPrice        Decimal         @db.Decimal(12, 2)
  sellingPrice   Decimal         @db.Decimal(12, 2)
  gettingPrice   Decimal         @db.Decimal(12, 2) 
  
  // Media
  mainImage      String
  promoImage     String?
  liveImages     String[]
  youtubeId      String?
  
  // Attributes
  colors         String[]
  quality        String
  sizes          String[]
  materials      String[]
  specs          Json?           
  
  // Inventory
  totalStock     Int             @default(0)
  sku            String?         @unique
  
  // Matrix (Real-time data)
  liveWatching   Int             @default(0)
  liveSold       Int             @default(0)
  
  // Marketing
  collections    String[]
  isFeatured     Boolean         @default(false)
  seoTitle       String?
  seoDescription String?
  
  // Social Proof
  averageRating  Float           @default(4.0)
  totalReviews   Int             @default(0)

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  reviews        Review[]
  variants       ProductVariant[]
  sellers        ProductSeller[]
  
  @@index([category])
  @@index([status])
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  size      String
  color     String
  stock     Int      @default(0)
  price     Decimal? @db.Decimal(12, 2) 

  @@index([productId])
  @@map("product_variants")
}

model ProductSeller {
  id           String  @id @default(uuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  sellerId     String
  seller       User    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  
  gettingPrice Decimal @db.Decimal(12, 2)
  stock        Int     @default(0)
  isVerified   Boolean @default(false)

  @@index([productId])
  @@index([sellerId])
  @@map("product_sellers")
}
