enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  RAZORPAY
  STRIPE
  WALLET
}

model Order {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderNumber String @unique // Customer facing reference

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod

  // Totals
  totalAmount    Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  shippingFees   Decimal @default(0) @db.Decimal(12, 2)
  finalAmount    Decimal @db.Decimal(12, 2)

  // Shipping (Snapshot of user address at order time)
  shippingAddress Json
  trackingNumber  String?
  courierPartner  String?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  // We keep essential data even if product is deleted
  name      String
  image     String
  size      String
  color     String
  price     Decimal @db.Decimal(12, 2)
  quantity  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@map("order_items")
}
