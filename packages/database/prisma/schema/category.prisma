model Category {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  image     String
  gender    Gender
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  position  Int       @default(0)
  sizes     String[]  @default([])
  products  Product[]
  sellers   Seller[]  @relation("CategoryToSeller")

  @@map("categories")
}
