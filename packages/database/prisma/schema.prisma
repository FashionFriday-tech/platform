// --- Entry Point for Prisma Schema ---
// This file is the "compiled" output for Prisma.
// The scalable, source-of-truth files are located in ./models/*.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

