{
  "name": "@ff/database",
  "version": "0.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.ts",
  "scripts": {
    "build": "pnpm generate && tsc",
    "generate": "prisma generate --schema ./prisma/schema",
    "migrate": "prisma migrate dev --schema ./prisma/schema",
    "db:push": "prisma db push --schema ./prisma/schema",
    "studio": "prisma studio --schema ./prisma/schema",
    "db:seed": "pnpm dlx tsx prisma/seed-products.ts"
  },
  "include": [
    "src"
  ],
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1077.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^11.0.0",
    "dotenv": "^17.4.2",
    "prisma": "5.22.0",
    "sharp": "^0.35.2",
    "typescript": "^5.7.3",
    "uuid": "^13.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^5.22.0",
    "@prisma/client": "5.22.0",
    "pg": "^8.20.0",
    "server-only": "^0.0.1"
  }
}
